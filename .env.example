# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API. These two are also set on Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Timezone used to show and enter match times (also set on Vercel).
NEXT_PUBLIC_LEAGUE_TZ=Asia/Kolkata

# ---- Local scripts only. Never add these to Vercel. ----
# Secret (service_role) key: used by `npm run admin:add` to create organizer logins.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: direct connection for `npm run db:demo` / `db:wipe` (Supabase → Connect → Session pooler).
DATABASE_URL=
